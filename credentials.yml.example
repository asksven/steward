# credentials.yml.example
#
# Copy this file to credentials.yml on the host (gitignored) and adjust the
# key_file paths before use. Never commit credentials.yml itself.
#
# credentials.yml maps each SSH git host to its own deploy key (delivered as a
# Docker secret). Use it when repos span multiple git hosts (e.g. GitHub +
# GitLab) and each host needs a separate key. When credentials.yml is present,
# steward uses it and ignores the single-key ssh_key secret.
#
# Add one pattern per host you clone from. key_file is the container path of a
# mounted secret - add the matching secret to docker-compose.override.yml
# (Option B in docker-compose.override.yml.example).

credentials:
  - pattern: github.com
    key_file: /run/secrets/github_key
  - pattern: gitlab.com
    key_file: /run/secrets/gitlab_key

# Optional. If set, steward enforces StrictHostKeyChecking=yes and this file
# MUST contain the host key for EVERY git host above (see Quick start step 4).
# Generate with ssh-keyscan and APPEND each additional host, never overwrite:
#
#   ssh-keyscan -t rsa,ecdsa,ed25519 github.com  >  ~/.ssh/steward_known_hosts
#   ssh-keyscan -t rsa,ecdsa,ed25519 gitlab.com  >> ~/.ssh/steward_known_hosts
#
# Remove this line to use accept-new (trust on first use) instead.
known_hosts_file: /run/secrets/ssh_known_hosts