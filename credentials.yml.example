# credentials.yml.example
#
# Maps git hosts (or per-repo SSH aliases) to SSH deploy keys. Copy to
# credentials.yml (gitignored) and mount it read-only into the container via
# docker-compose.override.yml. scripts/setup.sh generates this for you.
#
# Each entry becomes a Host block in the container's ~/.ssh/config. The key_file
# paths are container-internal (Docker secrets live under /run/secrets).

credentials:
  # Control repo — and any other repo reachable with this single key.
  - pattern: github.com
    key_file: /run/secrets/control_key

  # ── Additional per-repo keys (GitHub) ────────────────────────────────────────
  # GitHub forbids reusing one deploy key across repositories, so each extra
  # GitHub repo needs its own key AND its own SSH host alias. Steps:
  #   1. Generate a key:  ssh-keygen -t ed25519 -f ~/.ssh/steward_arr_key -N ""
  #   2. Add the .pub as a read-only deploy key on that repo.
  #   3. Declare an arr_key secret in docker-compose.override.yml.
  #   4. Add an entry below with a unique 'pattern' alias + the real 'hostname'.
  #   5. Use the alias in the app manifest's repo URL:
  #        repo: git@github.com-arr:you/arr-stack.git
  #
  # - pattern: github.com-arr      # SSH host alias — must be unique
  #   hostname: github.com         # the real host the alias maps to
  #   key_file: /run/secrets/arr_key

# Optional. When set, steward enforces StrictHostKeyChecking=yes and this file
# MUST contain the host key for every host above. scripts/setup.sh populates it
# via ssh-keyscan. Remove this line to fall back to accept-new (trust on first use).
known_hosts_file: /run/secrets/ssh_known_hosts
