# docker-compose.override.yml.example
#
# Copy this file to docker-compose.override.yml and edit the host key paths.
# docker-compose.override.yml is gitignored — it holds host-specific paths
# (your deploy keys, known_hosts, and credentials.yml).
#
# scripts/setup.sh generates this file for you; edit by hand only if you are
# doing a manual setup.
#
# steward selects an SSH deploy key per git host (or per-repo alias) via
# credentials.yml, which is mounted read-only into the container. Every key that
# credentials.yml references must be declared as a Docker secret below.

services:
  steward:
    volumes:
      # credentials.yml maps hosts/aliases → key_file (container paths under /run/secrets).
      - ./credentials.yml:/app/credentials.yml:ro
    secrets:
      - control_key
      - ssh_known_hosts
      # Add one secret per additional per-repo key, e.g.:
      # - arr_key

    # Expose the Prometheus metrics port here if METRICS_PORT is set in .env:
    # ports:
    #   - "9101:9101"

secrets:
  # Deploy key for the control repo (and any repo reachable with this one key).
  control_key:
    file: /home/you/.ssh/steward_deploy_key
  # Populated by ssh-keyscan; referenced by known_hosts_file in credentials.yml.
  ssh_known_hosts:
    file: /home/you/.ssh/steward_known_hosts
  # ── Additional per-repo keys (GitHub requires one key per repo) ───────────────
  # arr_key:
  #   file: /home/you/.ssh/steward_arr_key
