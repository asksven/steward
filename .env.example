# ── Required ──────────────────────────────────────────────────────────────────

# SSH URL of the control repo (git@host:path or ssh://host/path).
# Plain HTTPS is also supported. HTTPS with embedded credentials is not.
CONTROL_REPO_URL=git@github.com:you/homelab-gitops.git

# Must match the directory name under nodes/ in your control repo.
GITOPS_NODE_NAME=node1.lan

# Host path where steward clones repos and stores state (outside the container).
STEWARD_DATA_DIR=/opt/steward-data

# ── Recommended ───────────────────────────────────────────────────────────────

# Run steward as your host user so files in STEWARD_DATA_DIR are not root-owned.
# Uncomment and set to the output of `id -u` and `id -g`:
# STEWARD_UID=1000
# STEWARD_GID=1000

# ── Optional ──────────────────────────────────────────────────────────────────

# Branch to track on the control repo (default: main).
# CONTROL_REPO_BRANCH=main

# Log level. Set to DEBUG for verbose output (default: INFO).
# LOGLEVEL=INFO

# Port to expose the Prometheus /metrics endpoint on the host.
# Leave unset to disable metrics entirely.
# METRICS_PORT=9101
